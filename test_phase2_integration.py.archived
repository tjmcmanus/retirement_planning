"""
Integration Tests for Phase 2: Parallel Implementation

Tests that the factory function and WithdrawalStrategyEngine work correctly
with both old and new stage implementations.
"""

import pytest
import os
from typing import List

import strategy
from strategy import (
    WithdrawalStrategyEngine,
    create_life_stages,
    USE_REFACTORED_STAGES,
    REFACTORED_STAGES_AVAILABLE
)


class TestPhase2Integration:
    """Test Phase 2 parallel implementation"""
    
    def test_factory_creates_old_stages(self):
        """Test factory creates original stage instances"""
        stages = create_life_stages(use_refactored=False)
        
        assert len(stages) == 7, "Should create 7 stages"
        
        # Verify stage types (original implementation)
        stage_names = [type(s).__name__ for s in stages]
        assert 'Stage7SurvivingSpouse' in stage_names
        assert 'Stage1Accumulation' in stage_names
        assert 'Stage2PrepForRetirement' in stage_names
        assert 'Stage3EarlyRetirement' in stage_names
        assert 'Stage4Medicare' in stage_names
        assert 'Stage5SocialSecurity' in stage_names
        assert 'Stage6RMD' in stage_names
    
    def test_factory_creates_new_stages(self):
        """Test factory creates refactored stage instances"""
        if not REFACTORED_STAGES_AVAILABLE:
            pytest.skip("Refactored stages not available")
        
        stages = create_life_stages(use_refactored=True)
        
        assert len(stages) == 7, "Should create 7 stages"
        
        # All stages should have the same interface
        for stage in stages:
            assert hasattr(stage, 'applies'), f"{type(stage).__name__} missing applies method"
            assert hasattr(stage, 'calculate_strategy'), f"{type(stage).__name__} missing calculate_strategy method"
            assert hasattr(stage, 'name'), f"{type(stage).__name__} missing name attribute"
    
    def test_factory_fallback_when_refactored_unavailable(self):
        """Test factory falls back to old stages if refactored unavailable"""
        # This test simulates the case where refactored stages can't be imported
        # In reality, they're available, but we test the fallback logic
        stages = create_life_stages(use_refactored=False)
        assert len(stages) == 7
    
    def test_engine_uses_old_stages_by_default(self):
        """Test engine uses original stages when flag is False"""
        engine = WithdrawalStrategyEngine(use_refactored_stages=False)
        
        assert len(engine.stages) == 7
        assert engine.brokerage_account is None
        
        # Verify it's using original stages
        stage_names = [type(s).__name__ for s in engine.stages]
        assert 'Stage7SurvivingSpouse' in stage_names
    
    def test_engine_uses_new_stages_when_enabled(self):
        """Test engine uses refactored stages when flag is True"""
        if not REFACTORED_STAGES_AVAILABLE:
            pytest.skip("Refactored stages not available")
        
        engine = WithdrawalStrategyEngine(use_refactored_stages=True)
        
        assert len(engine.stages) == 7
        assert engine.brokerage_account is None
    
    def test_engine_respects_environment_variable(self):
        """Test engine respects USE_REFACTORED_STAGES environment variable"""
        # Save original value
        original_value = strategy.USE_REFACTORED_STAGES
        
        try:
            # Test with False
            strategy.USE_REFACTORED_STAGES = False
            engine = WithdrawalStrategyEngine()
            assert len(engine.stages) == 7
            
            # Test with True (if available)
            if REFACTORED_STAGES_AVAILABLE:
                strategy.USE_REFACTORED_STAGES = True
                engine = WithdrawalStrategyEngine()
                assert len(engine.stages) == 7
        finally:
            # Restore original value
            strategy.USE_REFACTORED_STAGES = original_value
    
    def test_engine_parameter_overrides_environment(self):
        """Test engine parameter overrides environment variable"""
        # Save original value
        original_value = strategy.USE_REFACTORED_STAGES
        
        try:
            # Set environment to True
            strategy.USE_REFACTORED_STAGES = True
            
            # But override with False
            engine = WithdrawalStrategyEngine(use_refactored_stages=False)
            stage_names = [type(s).__name__ for s in engine.stages]
            assert 'Stage7SurvivingSpouse' in stage_names  # Original implementation
            
            # Set environment to False
            strategy.USE_REFACTORED_STAGES = False
            
            # But override with True (if available)
            if REFACTORED_STAGES_AVAILABLE:
                engine = WithdrawalStrategyEngine(use_refactored_stages=True)
                assert len(engine.stages) == 7
        finally:
            # Restore original value
            strategy.USE_REFACTORED_STAGES = original_value
    
    def test_stage_precedence_maintained(self):
        """Test that Stage 7 (Surviving Spouse) is checked first in both implementations"""
        # Old implementation
        old_stages = create_life_stages(use_refactored=False)
        assert 'Stage7' in type(old_stages[0]).__name__, "Stage 7 should be first (old)"
        
        # New implementation (if available)
        if REFACTORED_STAGES_AVAILABLE:
            new_stages = create_life_stages(use_refactored=True)
            assert 'Stage7' in type(new_stages[0]).__name__, "Stage 7 should be first (new)"
    
    def test_both_implementations_have_same_stage_count(self):
        """Test both implementations create the same number of stages"""
        old_stages = create_life_stages(use_refactored=False)
        
        if REFACTORED_STAGES_AVAILABLE:
            new_stages = create_life_stages(use_refactored=True)
            assert len(old_stages) == len(new_stages), "Both should have 7 stages"
    
    def test_stage_interface_consistency(self):
        """Test all stages have consistent interface regardless of implementation"""
        for use_refactored in [False, True]:
            if use_refactored and not REFACTORED_STAGES_AVAILABLE:
                continue
            
            stages = create_life_stages(use_refactored=use_refactored)
            
            for stage in stages:
                # All stages must have these methods/attributes
                assert hasattr(stage, 'applies'), f"{type(stage).__name__} missing applies"
                assert hasattr(stage, 'calculate_strategy'), f"{type(stage).__name__} missing calculate_strategy"
                assert hasattr(stage, 'name'), f"{type(stage).__name__} missing name"
                
                # Verify methods are callable
                assert callable(stage.applies), f"{type(stage).__name__}.applies not callable"
                assert callable(stage.calculate_strategy), f"{type(stage).__name__}.calculate_strategy not callable"
    
    def test_dependency_injection_singletons(self):
        """Test that dependency injection uses singleton pattern"""
        if not REFACTORED_STAGES_AVAILABLE:
            pytest.skip("Refactored stages not available")
        
        # Get calculator instances
        calc1 = strategy.get_tax_calculator()
        calc2 = strategy.get_tax_calculator()
        
        # Should be the same instance (singleton)
        assert calc1 is calc2, "TaxCalculator should be singleton"
        
        # Get account manager instances
        mgr1 = strategy.get_account_manager()
        mgr2 = strategy.get_account_manager()
        
        # Should be the same instance (singleton)
        assert mgr1 is mgr2, "AccountManager should be singleton"
    
    def test_comparison_mode_flag_exists(self):
        """Test that comparison mode flag is defined"""
        assert hasattr(strategy, 'COMPARE_IMPLEMENTATIONS')
        assert isinstance(strategy.COMPARE_IMPLEMENTATIONS, bool)


class TestPhase2RegressionSafety:
    """Test that Phase 2 doesn't break existing functionality"""
    
    def test_default_behavior_unchanged(self):
        """Test that default behavior uses original implementation"""
        # With default settings, should use original stages
        engine = WithdrawalStrategyEngine()
        
        # Should have 7 stages
        assert len(engine.stages) == 7
        
        # Should have brokerage_account attribute
        assert hasattr(engine, 'brokerage_account')
        assert engine.brokerage_account is None
    
    def test_determine_stage_method_exists(self):
        """Test that determine_stage method still exists"""
        engine = WithdrawalStrategyEngine(use_refactored_stages=False)
        
        assert hasattr(engine, 'determine_stage')
        assert callable(engine.determine_stage)
    
    def test_no_import_errors(self):
        """Test that strategy module imports without errors"""
        # If we got here, imports worked
        assert strategy is not None
        assert hasattr(strategy, 'WithdrawalStrategyEngine')
        assert hasattr(strategy, 'create_life_stages')


if __name__ == '__main__':
    pytest.main([__file__, '-v'])

