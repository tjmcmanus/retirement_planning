# IBM Passport Advantage RPA Configuration Template
# Copy this file to .env and fill in your credentials

# IBM w3id Credentials
IBM_W3ID_USERNAME=your_ibm_email@ibm.com
IBM_W3ID_PASSWORD=your_password_here

# Scraper Configuration
HEADLESS_MODE=false
TIMEOUT_SECONDS=20
MAX_RETRIES=3

# Output Configuration
OUTPUT_FORMAT=csv
OUTPUT_DIRECTORY=./output